{
  "manifest_version": 3,
  "name": "Avantis FireWall Search Protection",
  "version": "1.0.0",
  "description": "Blocks configured risky search terms and domains in Chrome.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://google.com/*",
    "https://*.google.com/*",
    "https://google.co.zw/*",
    "https://*.google.co.zw/*",
    "https://www.bing.com/*",
    "https://duckduckgo.com/*",
    "https://www.duckduckgo.com/*",
    "https://search.yahoo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://google.com/*",
        "https://*.google.com/*",
        "https://google.co.zw/*",
        "https://*.google.co.zw/*",
        "https://www.bing.com/*",
        "https://duckduckgo.com/*",
        "https://www.duckduckgo.com/*",
        "https://search.yahoo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["rules.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Avantis Safety Center",
    "default_popup": "safety.html"
  }
}
